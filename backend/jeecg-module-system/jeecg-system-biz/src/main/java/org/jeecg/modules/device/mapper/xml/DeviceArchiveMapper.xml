<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.device.mapper.DeviceArchiveMapper">

    <!-- 根据设备编号查询设备档案 -->
    <select id="getByDeviceCode" resultType="org.jeecg.modules.device.entity.DeviceArchive">
        select * from device_archive where device_code = #{deviceCode}
    </select>

</mapper>
